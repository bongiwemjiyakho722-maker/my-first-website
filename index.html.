<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Royal Bites Restaurant · Palm Ridge, Johannesburg</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root{--bg:#0b0907;--bg2:#14100c;--line:#3a2e1c;--gold:#d9a94e;--gold2:#f0c878;--ink:#f6efe3;--mute:#b3a58e;--serif:'Cormorant Garamond',Georgia,serif;--sans:'Jost',system-ui,sans-serif;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:dark}
*,*::before,*::after{box-sizing:inherit}html{scroll-behavior:smooth;scroll-padding-top:84px}
body{margin:0;background:var(--bg);color:var(--ink);font:300 17px/1.7 var(--sans)}
img{max-width:100%}a{color:inherit;text-decoration:none}
h1,h2,h3{font-family:var(--serif);font-weight:500;line-height:1.05;margin:0}
h2{font-size:clamp(2.4rem,5vw,4rem)}
.wrap{max-width:1180px;margin:0 auto;padding:0 24px}
section{padding:110px 0}
.btn{display:inline-block;border:1px solid var(--gold);padding:14px 30px;border-radius:40px;font-weight:500;font-size:.95rem;letter-spacing:.04em;cursor:pointer;background:transparent;color:var(--ink);font-family:var(--sans);transition:.3s}
.btn.fill{background:var(--gold);color:#1a1205}.btn:hover{background:var(--gold2);color:#1a1205}
:focus-visible{outline:2px solid var(--gold2);outline-offset:3px}
/* nav */
nav{position:fixed;top:0;left:0;right:0;z-index:50;padding-top:env(safe-area-inset-top,0px);transition:.4s}
nav.s{background:rgba(11,9,7,.92);backdrop-filter:blur(12px);border-bottom:1px solid var(--line)}
.nb{display:flex;align-items:center;justify-content:space-between;height:78px;gap:20px}
.logo{font-family:var(--serif);font-size:1.9rem;font-weight:600;color:var(--gold2);line-height:1}
.logo small{display:block;font:400 .58rem var(--sans);letter-spacing:.5em;color:var(--mute);margin-top:4px}
.links{display:flex;gap:30px;font-size:.95rem}.links a{opacity:.85}.links a:hover{color:var(--gold2);opacity:1}
.nr{display:flex;align-items:center;gap:14px}
.cartb{position:relative;background:none;border:1px solid var(--line);color:var(--ink);border-radius:40px;padding:9px 16px;cursor:pointer;font:400 .9rem var(--sans)}
.cartb b{background:var(--gold);color:#1a1205;border-radius:20px;padding:1px 8px;margin-left:6px;font-weight:500}
.burger{display:none;background:none;border:0;color:var(--ink);font-size:1.7rem;cursor:pointer}
/* hero */
.hero{min-height:100vh;min-height:100svh;display:flex;align-items:center;position:relative;padding:130px 0 90px;background:#0b0907;overflow:hidden}.hero::before{content:"";position:absolute;inset:0;background:var(--cake) center/cover;transform:scaleX(-1)}.hero::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,#0b0907 8%,rgba(11,9,7,.6) 55%,rgba(11,9,7,.25)),linear-gradient(0deg,#0b0907,transparent 35%)}.hero .wrap{position:relative;z-index:1}
.hero h1{font-size:clamp(3.4rem,9vw,8rem);max-width:9ch;animation:rise 1.4s cubic-bezier(.2,.7,.2,1) both}
.hero h1 em{display:block;color:var(--gold);font-style:italic}
.hero p{max-width:32ch;color:#e6dac5;font-size:1.15rem;margin:26px 0 38px;animation:rise 1.4s .25s both}
.hero .cta{display:flex;gap:14px;flex-wrap:wrap;animation:rise 1.4s .45s both}
.tag{font-size:.95rem;letter-spacing:.3em;color:var(--gold);margin-bottom:22px}
@keyframes rise{from{opacity:0;transform:translateY(40px)}}
.rv{opacity:0;transition:opacity 1s}.rv.in{opacity:1}
/* menu */
.head{text-align:center;margin-bottom:50px}.head p{color:var(--mute);margin:14px 0 0}
.tabs{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-bottom:46px}
.tabs button{background:none;border:0;border-bottom:1px solid transparent;color:var(--mute);font:400 1rem var(--sans);padding:8px 16px;cursor:pointer}
.tabs button.on{color:var(--gold2);border-color:var(--gold)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:26px}
.card{background:var(--bg2);border:1px solid var(--line);border-radius:6px 28px 6px 28px;overflow:hidden;transition:.5s}
.card:hover{border-color:var(--gold);transform:translateY(-6px)}
.card .ph{aspect-ratio:16/11;overflow:hidden}.card .ph img{width:100%;height:100%;object-fit:cover;transition:transform 1.2s}.card:hover img{transform:scale(1.08)}
.card .bd{padding:22px 24px 26px}.card h3{font-size:1.65rem}.card p{color:var(--mute);font-size:.95rem;margin:8px 0 18px}
.row{display:flex;justify-content:space-between;align-items:center}.price{font-family:var(--serif);font-size:1.6rem;color:var(--gold2)}
.add{background:var(--gold);color:#1a1205;border:0;border-radius:30px;padding:8px 20px;font:500 .9rem var(--sans);cursor:pointer}
/* about */
.about{background:var(--bg2);border-block:1px solid var(--line)}
.two{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}
.about img{width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:180px 6px 6px 6px;border:1px solid var(--line)}
.about p{color:#d5c8b2}.sig{font-family:var(--serif);font-style:italic;font-size:1.7rem;color:var(--gold)}
.stats{display:flex;gap:40px;margin-top:30px}.stats b{display:block;font:500 2.6rem var(--serif);color:var(--gold2)}.stats span{font-size:.85rem;color:var(--mute)}
.ph0,.aph,.gal .p{display:flex;align-items:center;justify-content:center;background:radial-gradient(circle at 30% 20%,#2a2012,#100d09);border:1px solid var(--line);font:500 2.4rem var(--serif);color:var(--gold);letter-spacing:.1em}.aph{aspect-ratio:4/5;border-radius:180px 6px 6px 6px;font-size:4rem}.gal .p{cursor:default}
/* gallery */
.gal{grid-auto-flow:dense;display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:220px;gap:14px}
.gal div{overflow:hidden;border-radius:4px;cursor:zoom-in}.gal img{width:100%;height:100%;object-fit:cover;transition:1s}.gal div:hover img{transform:scale(1.1)}
.gal .w{grid-column:span 2}.gal .t{grid-row:span 2}
.lb{position:fixed;inset:0;background:rgba(0,0,0,.93);display:none;align-items:center;justify-content:center;z-index:90;padding:24px}.lb.on{display:flex}.lb img{max-height:88vh;border-radius:6px}
/* forms */
.panel{background:var(--bg2);border:1px solid var(--line);padding:40px;border-radius:6px 32px 6px 32px}
.f{display:grid;grid-template-columns:1fr 1fr;gap:18px}.f .full{grid-column:1/-1}
label{display:block;font-size:.85rem;color:var(--mute);margin-bottom:6px}
input,select,textarea{width:100%;background:#0b0907;border:1px solid var(--line);color:var(--ink);padding:13px 14px;border-radius:4px;font:300 1rem var(--sans)}
input:focus,select:focus,textarea:focus{border-color:var(--gold);outline:0}
.ok{display:none;margin-top:20px;border:1px solid var(--gold);padding:18px;border-radius:6px;color:var(--gold2)}
.res{background:linear-gradient(rgba(11,9,7,.84),rgba(11,9,7,.92)),var(--room) center/cover}
/* contact */
.info p{margin:0 0 18px;color:#d5c8b2}.info b{display:block;color:var(--gold);font-weight:400;font-size:.85rem;letter-spacing:.12em}
.map{width:100%;height:100%;min-height:340px;border:1px solid var(--line);border-radius:6px;filter:grayscale(1) invert(.9) contrast(.9)}
.soc{display:flex;gap:12px;flex-wrap:wrap}.soc a{border:1px solid var(--line);padding:6px 16px;border-radius:30px;font-size:.9rem}.soc a:hover{border-color:var(--gold)}
footer{border-top:1px solid var(--line);padding:50px 0 36px;color:var(--mute);font-size:.9rem}
.fg{display:flex;justify-content:space-between;gap:30px;flex-wrap:wrap;align-items:center}
/* cart */
.dr{position:fixed;top:0;right:0;bottom:0;width:min(440px,100%);background:#100d09;border-left:1px solid var(--line);z-index:80;transform:translateX(105%);transition:.5s;display:flex;flex-direction:column;padding:28px}
.dr.on{transform:none}.dr h3{font-size:2rem;margin-bottom:18px}
.items{flex:1;overflow:auto}.it{display:flex;justify-content:space-between;gap:12px;padding:14px 0;border-bottom:1px solid var(--line)}
.q button{width:28px;height:28px;border-radius:50%;border:1px solid var(--gold);background:none;color:var(--ink);cursor:pointer}.q span{margin:0 8px}
.tot{display:flex;justify-content:space-between;font:500 1.6rem var(--serif);padding:18px 0}
.sh{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:70;display:none}.sh.on{display:block}
.close{position:absolute;top:18px;right:22px;background:none;border:0;color:var(--ink);font-size:1.8rem;cursor:pointer}
#co{display:none}
@media(max-width:900px){.links{display:none;position:fixed;top:78px;left:0;right:0;background:#0b0907;flex-direction:column;padding:26px 24px;border-bottom:1px solid var(--line);gap:18px}.links.on{display:flex}.burger{display:block}.nr .book{display:none}.two{grid-template-columns:1fr;gap:40px}.gal{grid-template-columns:repeat(2,1fr);grid-auto-rows:170px}section{padding:76px 0}.f{grid-template-columns:1fr}.panel{padding:26px}.hero{background-position:70% center}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.rv{opacity:1}html{scroll-behavior:auto}}
</style></head><body>
<nav id="nav"><div class="wrap nb">
<a href="#top" class="logo">Royal Bites<small>RESTAURANT</small></a>
<div class="links" id="links"><a href="#menu">Menu</a><a href="#order">Order Online</a><a href="#reserve">Reservations</a><a href="#about">About Us</a><a href="#gallery">Gallery</a><a href="#contact">Contact</a></div>
<div class="nr"><button class="cartb" onclick="cart(1)" aria-label="Open cart">Cart<b id="cc">0</b></button><a class="btn fill book" href="#reserve" style="padding:10px 22px">Book a table</a><button class="burger" onclick="links.classList.toggle('on')" aria-label="Menu">&#9776;</button></div>
</div></nav>

<header class="hero" id="top"><div class="wrap">
<div class="tag">GOOD FOOD. GOOD MOOD.</div>
<h1>Welcome to <em>Royal Bites</em></h1>
<p>Fire, smoke and gold light. A table at Palm Ridge where the grill is never quiet.</p>
<div class="cta"><a class="btn fill" href="#menu">Explore our menu</a><a class="btn" href="#reserve">Reserve a table</a></div>
</div></header>

<section id="menu"><div class="wrap">
<div class="head"><h2>Our Menu</h2><p>A variety of delicious meals for every taste. Prices in rand (R).</p></div>
<div class="tabs" id="tabs"></div><div class="grid" id="mg"></div>
</div></section>

<section id="order" class="res"><div class="wrap two">
<div><h2>Order online</h2><p style="color:#d5c8b2;max-width:44ch;margin:20px 0 30px">Craving something delicious? Add dishes from the menu to your cart and we will deliver across Palm Ridge, Alberton and surrounds, or have it ready for collection.</p><a class="btn fill" href="#menu">Browse dishes</a> <button class="btn" onclick="cart(1)">View cart</button></div>
<div class="panel"><h3 style="font-size:2rem;margin-bottom:14px">How it works</h3><p>Choose your dishes. Review your cart. Pay at the door or by card on delivery. Orders usually arrive in 35 to 50 minutes.</p><p style="color:var(--gold2);margin:0">Delivery from R35 · Free over R500</p></div>
</div></section>

<section id="about" class="about"><div class="wrap two">
<img id="aimg" alt="Royal Bites dining room with gold chandeliers and marble tables" style="object-position:30% center">
<div><h2>More than just a restaurant</h2>
<p style="margin:24px 0">Royal Bites began with one grill and one belief: food brings people together. Every steak is aged, every sauce is made from scratch, and every table is set as if a guest of honour is arriving.</p>
<p>We cook over open flame, source locally where we can, and serve in a room of dark wood, brass and candlelight built for long evenings.</p>
<p class="sig">Chef Sabatha, Head Chef</p>
<div class="stats"><div><b>12</b><span>years of service</span></div><div><b>40+</b><span>dishes cooked daily</span></div><div><b>4.8</b><span>guest rating</span></div></div></div>
</div></section>

<section id="gallery"><div class="wrap"><div class="head"><h2>Gallery</h2><p>Food, room and evenings at Royal Bites.</p></div>
<div class="gal" id="gal"></div></div></section>

<section id="reserve" class="res"><div class="wrap" style="max-width:820px">
<div class="head"><h2>Reserve your table</h2><p>Book online and enjoy a hassle-free dining experience.</p></div>
<form class="panel f" id="rf">
<div><label for="rd">Date</label><input type="date" id="rd" required></div>
<div><label for="rt">Time</label><select id="rt"></select></div>
<div><label for="rg">Guests</label><select id="rg"></select></div>
<div><label for="rn">Full name</label><input id="rn" required autocomplete="name"></div>
<div><label for="rp">Phone</label><input id="rp" type="tel" required autocomplete="tel"></div>
<div><label for="re">Email</label><input id="re" type="email" required autocomplete="email"></div>
<div class="full"><label for="rm">Special requests</label><textarea id="rm" rows="3" placeholder="Allergies, celebrations, seating"></textarea></div>
<div class="full"><button class="btn fill" type="submit">Confirm reservation</button></div>
<div class="ok full" id="rok"></div>
</form></div></section>

<section id="contact"><div class="wrap two" style="align-items:stretch">
<div class="info"><h2 style="margin-bottom:30px">Find us</h2>
<p><b>ADDRESS</b>123 Food Street, Palm Ridge, Johannesburg</p>
<p><b>PHONE</b><a href="tel:+2785867662">085 867 662</a></p>
<p><b>WHATSAPP</b><a href="https://wa.me/2785867662" style="color:var(--gold2)">Message us on WhatsApp</a></p>
<p><b>OPENING HOURS</b>Monday to Sunday, 09:00 to 23:00</p>
<div class="soc"><a href="#">Facebook</a><a href="#">Instagram</a><a href="#">TikTok</a><a href="#">YouTube</a></div></div>
<div><iframe class="map" title="Map of Palm Ridge, Johannesburg" loading="lazy" src="https://www.google.com/maps?q=Palm+Ridge+Johannesburg&output=embed"></iframe>
<p style="margin:10px 0 0;font-size:.85rem"><a href="https://www.google.com/maps/search/?api=1&query=Palm+Ridge+Johannesburg" style="color:var(--gold2)">Open in Google Maps</a></p></div>
</div></section>

<footer><div class="wrap fg"><div><div class="logo">Royal Bites<small>RESTAURANT</small></div></div>
<div>123 Food Street, Palm Ridge · 085 867 662<br>Mon to Sun 09:00 to 23:00</div>
<form onsubmit="event.preventDefault();this.innerHTML='<span style=color:var(--gold2)>You are subscribed.</span>'" style="display:flex;gap:8px"><input type="email" required placeholder="Your email address" aria-label="Email" style="width:210px;border-radius:30px"><button class="add">Subscribe</button></form></div>
<div class="wrap" style="margin-top:30px">&copy; 2026 Royal Bites Restaurant. Sample brand and content; edit freely.</div></footer>

<div class="sh" id="sh" onclick="cart(0)"></div>
<aside class="dr" id="dr" aria-label="Cart"><button class="close" onclick="cart(0)" aria-label="Close">&times;</button>
<h3>Your order</h3><div class="items" id="items"></div>
<div class="tot"><span>Total</span><span id="tot">R0</span></div>
<button class="btn fill" id="cob" onclick="co.style.display='block';this.style.display='none'">Proceed to checkout</button>
<form id="co" onsubmit="return pay(event)"><div style="display:grid;gap:10px">
<input placeholder="Full name" required aria-label="Name"><input type="tel" placeholder="Phone" required aria-label="Phone"><input placeholder="Delivery address" required aria-label="Address">
<select aria-label="Payment"><option>Pay on delivery</option><option>Card on delivery</option></select>
<button class="btn fill">Place order</button></div></form></aside>
<div class="lb" id="lb" onclick="this.classList.remove('on')"><img id="lbi" alt=""></div>

<script>
const IMG={hero:"data:image/jpeg;base64,",room:"data:image/jpeg;base64,",steak:"data:image/jpeg;base64,",pasta:"data:image/jpeg;base64,",burger:"data:image/jpeg;base64,",prawns:"data:image/jpeg;base64,",pizza:"data:image/jpeg;base64,",salad:"data:image/jpeg;base64,",cake:"data:image/jpeg;base64,",drink:"data:image/jpeg;base64,",soup:"data:image/jpeg;base64,"};
document.documentElement.style.setProperty('--hero','url('+IMG.hero+')');document.documentElement.style.setProperty('--cake','url('+IMG.prawns+')');document.documentElement.style.setProperty('--room','url('+IMG.room+')');aimg.src=IMG.room;
const M={Starters:[["Mushroom Velouté","Wild mushroom cream, thyme, toasted sourdough",85,"soup"],["Royal Garden Salad","Tomato, cucumber, feta, olives, red onion, house dressing",79,"salad"]],
"Main Courses":[["Royal Burger","Aged cheddar, fresh tomato, brioche bun, golden fries",165,"burger"],["Margherita Reale","Wood-fired, tomato, mozzarella, mushroom, basil",125,"pizza"]],
Grills:[["Signature Ribeye","Rosemary, pepper jus, buttery mash, asparagus",295,"steak"],["Flame-Grilled Sirloin","Charred over open fire, roasted tomato, hand-cut chips",245,"hero"]],
Seafood:[["Grilled Tiger Prawns","Peri-peri butter, lemon, garden leaves",285,"prawns"],["Prawn Fettuccine","Creamy garlic sauce, cherry tomato, parsley",195,"pasta"]],
Desserts:[["Chocolate Layer Cake","Dark chocolate, vanilla ice cream, fresh strawberry",85,"cake"]],
Beverages:[["Sunset Cooler","Orange, passion fruit, grenadine, mint, ice",55,"drink"]]};
const pos={hero:"60% 60%"};let cat="Starters",C={};
function tabsR(){tabs.innerHTML=Object.keys(M).map(k=>`<button class="${k==cat?'on':''}" onclick="cat='${k}';tabsR();grid()">${k}</button>`).join('')}
function grid(){mg.innerHTML=M[cat].map((d,i)=>`<article class="card"><div class="ph">${!IMG[d[3]]?'<div class="ph0" style="width:100%;height:100%">RB</div>':''}${IMG[d[3]]?`<img src="${IMG[d[3]]}" alt="${d[0]}" style="${d[3]=='hero'?'object-position:60% 70%;transform-origin:60% 70%':''}">`:''}</div><div class="bd"><h3>${d[0]}</h3><p>${d[1]}</p><div class="row"><span class="price">R${d[2]}</span><button class="add" onclick="add('${cat}',${i})">Add to cart</button></div></div></article>`).join('')}
function add(c,i){const d=M[c][i];C[d[0]]=C[d[0]]||{p:d[2],n:0};C[d[0]].n++;draw();cc.parentElement.animate([{transform:'scale(1.12)'},{transform:'scale(1)'}],250)}
function chg(k,v){C[k].n+=v;if(C[k].n<1)delete C[k];draw()}
function draw(){const k=Object.keys(C);cc.textContent=k.reduce((a,x)=>a+C[x].n,0);items.innerHTML=k.length?k.map(x=>`<div class="it"><div>${x}<br><small style="color:var(--mute)">R${C[x].p}</small></div><div class="q"><button onclick="chg('${x}',-1)" aria-label="Less">&minus;</button><span>${C[x].n}</span><button onclick="chg('${x}',1)" aria-label="More">+</button></div></div>`).join(''):'<p style="color:var(--mute)">Your cart is empty. Add a dish from the menu to start.</p>';tot.textContent='R'+k.reduce((a,x)=>a+C[x].p*C[x].n,0)}
function cart(o){dr.classList.toggle('on',!!o);sh.classList.toggle('on',!!o)}
function pay(e){e.preventDefault();if(!Object.keys(C).length){alert('Your cart is empty. Add a dish first.');return false}C={};draw();items.innerHTML='<p style="color:var(--gold2)">Order placed. We will call you to confirm within a few minutes.</p>';co.style.display='none';cob.style.display='block';return false}
tabsR();grid();draw();
gal.innerHTML=[["room","w"],["steak","t"],["burger",""],["cake",""],["pizza",""],["prawns","w"],["drink",""],["pasta",""]].map(g=>IMG[g[0]]?`<div class="${g[1]}"><img src="${IMG[g[0]]}" alt="Royal Bites gallery" loading="lazy"></div>`:`<div class="p ${g[1]}">RB</div>`).join('');
gal.onclick=e=>{const i=e.target.closest('img');if(i){lbi.src=i.src;lb.classList.add('on')}};
rt.innerHTML=['12:00','13:00','14:00','17:00','18:00','19:00','20:00','21:00','22:00'].map(t=>`<option>${t}</option>`).join('');
rg.innerHTML=[1,2,3,4,5,6,7,8].map(n=>`<option>${n} guest${n>1?'s':''}</option>`).join('');
rd.min=rd.value=new Date().toISOString().slice(0,10);
rf.onsubmit=e=>{e.preventDefault();rok.style.display='block';rok.textContent=`Table requested for ${rg.value} on ${rd.value} at ${rt.value}. We will confirm with ${rn.value} by phone or email shortly.`;};
addEventListener('scroll',()=>nav.classList.toggle('s',scrollY>60),{passive:true});
document.querySelectorAll('.links a').forEach(a=>a.onclick=()=>links.classList.remove('on'));
addEventListener('keydown',e=>{if(e.key=='Escape'){cart(0);lb.classList.remove('on')}});
</script></body></html>
